{
  "title": "Homelab Overview",
  "uid": "homelab-overview",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "gridPos": {"x":0,"y":0,"w":4,"h":3},
      "title": "Nodes",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "options": {"colorMode":"background","graphMode":"none"},
      "fieldConfig": {"defaults":{"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green","value":null}]}}},
      "targets": [{"expr":"count(kube_node_info)","legendFormat":"nodes"}]
    },
    {
      "id": 2, "type": "stat", "gridPos": {"x":4,"y":0,"w":4,"h":3},
      "title": "Pods Running",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "options": {"colorMode":"background","graphMode":"none"},
      "fieldConfig": {"defaults":{"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":1}]}}},
      "targets": [{"expr":"count(kube_pod_status_phase{phase=\"Running\"})","legendFormat":"running"}]
    },
    {
      "id": 3, "type": "stat", "gridPos": {"x":8,"y":0,"w":4,"h":3},
      "title": "Pods Failing",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "options": {"colorMode":"background","graphMode":"none"},
      "fieldConfig": {"defaults":{"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green","value":null},{"color":"red","value":1}]}}},
      "targets": [{"expr":"count(kube_pod_status_phase{phase=~\"Failed|Unknown\"} == 1) or vector(0)","legendFormat":"failing"}]
    },
    {
      "id": 4, "type": "stat", "gridPos": {"x":12,"y":0,"w":4,"h":3},
      "title": "Pod Restarts (1h)",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "options": {"colorMode":"background","graphMode":"none"},
      "fieldConfig": {"defaults":{"color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":1},{"color":"red","value":5}]}}},
      "targets": [{"expr":"sum(increase(kube_pod_container_status_restarts_total[1h]))","legendFormat":"restarts"}]
    },
    {
      "id": 5, "type": "stat", "gridPos": {"x":16,"y":0,"w":4,"h":3},
      "title": "Cluster CPU %",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "options": {"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"]}},
      "fieldConfig": {"defaults":{"unit":"percent","color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":70},{"color":"red","value":90}]}}},
      "targets": [{"expr":"100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)","legendFormat":"cpu"}]
    },
    {
      "id": 6, "type": "stat", "gridPos": {"x":20,"y":0,"w":4,"h":3},
      "title": "Cluster Memory %",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "options": {"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"]}},
      "fieldConfig": {"defaults":{"unit":"percent","color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green","value":null},{"color":"yellow","value":75},{"color":"red","value":90}]}}},
      "targets": [{"expr":"(1 - (sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes))) * 100","legendFormat":"mem"}]
    },
    {
      "id": 10, "type": "timeseries", "gridPos": {"x":0,"y":3,"w":12,"h":8},
      "title": "CPU Usage per Node",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults":{"unit":"percent","custom":{"lineWidth":2}}},
      "targets": [{"expr":"100 - (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]) * 100)","legendFormat":"{{instance}}"}]
    },
    {
      "id": 11, "type": "timeseries", "gridPos": {"x":12,"y":3,"w":12,"h":8},
      "title": "Memory Usage per Node",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults":{"unit":"bytes","custom":{"lineWidth":2}}},
      "targets": [{"expr":"node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes","legendFormat":"{{instance}}"}]
    },
    {
      "id": 12, "type": "timeseries", "gridPos": {"x":0,"y":11,"w":12,"h":8},
      "title": "Network In per Node",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults":{"unit":"Bps","custom":{"lineWidth":2}}},
      "targets": [{"expr":"rate(node_network_receive_bytes_total{device!~\"lo|flannel.*|cni.*|veth.*\"}[5m])","legendFormat":"{{instance}} {{device}}"}]
    },
    {
      "id": 13, "type": "timeseries", "gridPos": {"x":12,"y":11,"w":12,"h":8},
      "title": "Network Out per Node",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults":{"unit":"Bps","custom":{"lineWidth":2}}},
      "targets": [{"expr":"rate(node_network_transmit_bytes_total{device!~\"lo|flannel.*|cni.*|veth.*\"}[5m])","legendFormat":"{{instance}} {{device}}"}]
    },
    {
      "id": 20, "type": "timeseries", "gridPos": {"x":0,"y":19,"w":24,"h":8},
      "title": "Pod Restarts Over Time (top 10)",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults":{"custom":{"lineWidth":2}}},
      "targets": [{"expr":"topk(10, increase(kube_pod_container_status_restarts_total[1h]))","legendFormat":"{{namespace}}/{{pod}}"}]
    },
    {
      "id": 21, "type": "table", "gridPos": {"x":0,"y":27,"w":24,"h":8},
      "title": "Pods Not Running",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "transformations": [{"id":"organize","options":{"excludeByName":{"Time":true,"__name__":true,"job":true}}}],
      "targets": [{"expr":"kube_pod_status_phase{phase!=\"Running\",phase!=\"Succeeded\"} == 1","legendFormat":"","instant":true,"format":"table"}]
    },
    {
      "id": 30, "type": "timeseries", "gridPos": {"x":0,"y":35,"w":12,"h":8},
      "title": "Log Volume by Namespace",
      "datasource": {"type":"loki","uid":"loki"},
      "fieldConfig": {"defaults":{"custom":{"lineWidth":2}}},
      "targets": [{"expr":"sum by (namespace) (count_over_time({namespace=~\".+\"}[5m]))","legendFormat":"{{namespace}}"}]
    },
    {
      "id": 31, "type": "timeseries", "gridPos": {"x":12,"y":35,"w":12,"h":8},
      "title": "Error Logs by Namespace",
      "datasource": {"type":"loki","uid":"loki"},
      "fieldConfig": {"defaults":{"custom":{"lineWidth":2,"fillOpacity":10},"color":{"fixedColor":"red","mode":"fixed"}}},
      "targets": [{"expr":"sum by (namespace) (count_over_time({namespace=~\".+\"} |~ \"(?i)(error|exception|fatal|panic)\" [5m]))","legendFormat":"{{namespace}} errors"}]
    },
    {
      "id": 32, "type": "logs", "gridPos": {"x":0,"y":43,"w":24,"h":10},
      "title": "Recent Errors (all namespaces)",
      "datasource": {"type":"loki","uid":"loki"},
      "options": {"showTime":true,"showLabels":false,"wrapLogMessage":true,"dedupStrategy":"none"},
      "targets": [{"expr":"{namespace=~\".+\"} |~ \"(?i)(error|exception|fatal|panic)\""}]
    },
    {
      "id": 40, "type": "timeseries", "gridPos": {"x":0,"y":53,"w":12,"h":8},
      "title": "Disk Usage per Node (root partition %)",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults":{"unit":"percent","custom":{"lineWidth":2}}},
      "targets": [{"expr":"100 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} * 100)","legendFormat":"{{instance}}"}]
    },
    {
      "id": 41, "type": "timeseries", "gridPos": {"x":12,"y":53,"w":12,"h":8},
      "title": "Disk Usage — NVMe Mounts",
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults":{"unit":"percent","custom":{"lineWidth":2}}},
      "targets": [{"expr":"100 - (node_filesystem_avail_bytes{mountpoint=~\"/mnt/.*\"} / node_filesystem_size_bytes{mountpoint=~\"/mnt/.*\"} * 100)","legendFormat":"{{instance}} {{mountpoint}}"}]
    }
  ],
  "templating": {"list": []}
}
