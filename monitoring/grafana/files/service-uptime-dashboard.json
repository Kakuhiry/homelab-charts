      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 12
      },
      "title": "Up / Down Timeline (last 7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 999,
                "result": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
