{
  "title": "Service Uptime",
  "uid": "service-uptime",
  "schemaVersion": 38,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**Up** = the Deployment has at least one available replica. **Down** = zero. `media/bazarr` is intentionally scaled to 0 (not in active use as of Aug 2026) and will always show Down here -- that's expected, not a fault. Hover any segment in the timeline below for its exact start/end and duration."
      }
    },
    {
      "id": 10,
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 2,
        "h": 4
      },
      "title": "jellyfin",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 999,
                "result": {
                  "text": "UP"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max by (namespace, deployment) (kube_deployment_status_replicas_available{namespace=\"media\",deployment=\"jellyfin\"})",
          "instant": true
        }
      ]
    },
